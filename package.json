{
  "name": "@local/sidebar-logo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Replace the DeepSeek Harness sidebar logo with your own mark image, wordmark image, name text, and badge tag.",
  "license": "MIT",
  "author": "cannebergeee",
  "homepage": "https://github.com/cannebergeee/dsh-sidebar-logo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cannebergeee/dsh-sidebar-logo.git"
  },
  "bugs": {
    "url": "https://github.com/cannebergeee/dsh-sidebar-logo/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "sidebar",
    "logo",
    "branding"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
